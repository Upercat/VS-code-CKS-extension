{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-b"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "watch",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "-b", "-w"],
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
